# =============================================================================
# Agentic AI Hub — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- RocketRide (AI Pipeline Engine — CORE) ---
# WebSocket URI of the RocketRide server (local or cloud)
ROCKETRIDE_API_URL=http://localhost:5565
ROCKETRIDE_API_KEY=
# Pipeline to run: provide a .pipe file path or a server-side pipeline ID
ROCKETRIDE_PIPELINE_FILE=
ROCKETRIDE_PIPELINE_ID=

# --- Spectrum (Unified Messaging) ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# --- XTrace Memory (Long-term Memory for AI Agents) ---
XTRACE_API_KEY=xtk_
XTRACE_ORG_ID=org_
XTRACE_GROUP_IDS=

# --- Butterbase (Backend-as-a-Service) ---
BUTTERBASE_API_URL=http://localhost:4000
BUTTERBASE_API_KEY=
BUTTERBASE_APP_ID=

# --- Browser Automation (Puppeteer) ---
BROWSER_START_URL=
