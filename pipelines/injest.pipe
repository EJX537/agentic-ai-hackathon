{
    "components": [
        {
            "id": "chat_1",
            "provider": "chat",
            "name": "Chat",
            "config": {
                "hideForm": true,
                "mode": "Source",
                "parameters": {},
                "type": "chat"
            },
            "ui": {
                "position": { "x": 20, "y": 200 },
                "nodeType": "default",
                "formDataValid": true
            }
        },
        {
            "id": "agent_rocketride_1",
            "provider": "agent_rocketride",
            "name": "RocketRide Wave",
            "config": {
                "instructions": [
                    "You are a web research assistant. Your job is to produce concise, factual answers to the user's questions.",
                    "",
                    "The user's query and any research context (memory recall, search results) are provided in the context block.",
                    "Use the context to ground your answer. If the context is insufficient, say so clearly.",
                    "",
                    "Format your answer as:",
                    "  1. Direct answer to the question",
                    "  2. Key findings (bulleted)",
                    "  3. Any caveats or missing information",
                    "",
                    "Keep answers under 400 words unless the user asks for detail."
                ],
                "max_waves": 10,
                "parameters": {}
            },
            "ui": {
                "position": { "x": 240, "y": 200 },
                "nodeType": "default",
                "formDataValid": true
            },
            "input": [
                {
                    "lane": "questions",
                    "from": "chat_1"
                }
            ]
        },
        {
            "id": "llm_anthropic_1",
            "provider": "llm_anthropic",
            "name": "Anthropic",
            "config": {
                "profile": "claude-sonnet-4-6",
                "claude-sonnet-4-6": {
                    "apikey": "${ROCKETRIDE_ANTHROPIC_KEY}"
                },
                "name": "Anthropic",
                "parameters": {}
            },
            "ui": {
                "position": { "x": 100, "y": 360 },
                "nodeType": "default",
                "formDataValid": true
            },
            "control": [
                {
                    "classType": "llm",
                    "from": "agent_rocketride_1"
                }
            ]
        },
        {
            "id": "tool_xtrace_memory_1",
            "provider": "tool_xtrace_memory",
            "name": "XTrace Memory",
            "config": {
                "api_key": "${ROCKETRIDE_XTRACE_API_KEY}",
                "org_id": "${ROCKETRIDE_XTRACE_ORG_ID}",
                "group_ids": "",
                "show_advanced": false,
                "type": "tool_xtrace_memory",
                "user_id": "${ROCKETRIDE_XTRACE_USER_ID}",
                "agent_id": "assistant",
                "search_mode": "compose",
                "parameters": {}
            },
            "ui": {
                "position": { "x": 500, "y": 360 },
                "nodeType": "default",
                "formDataValid": true
            },
            "control": [
                {
                    "classType": "tool",
                    "from": "agent_rocketride_1"
                }
            ]
        },
        {
            "id": "response_answers_1",
            "provider": "response_answers",
            "name": "Return Answers",
            "config": {
                "laneName": "answers"
            },
            "ui": {
                "position": { "x": 460, "y": 200 },
                "nodeType": "default",
                "formDataValid": true
            },
            "input": [
                {
                    "lane": "answers",
                    "from": "agent_rocketride_1"
                }
            ]
        }
    ],
    "project_id": "hackathon-injest",
    "version": 1,
    "isLocked": false,
    "snapToGrid": true,
    "snapGridSize": [10, 10],
    "docRevision": 1
}
