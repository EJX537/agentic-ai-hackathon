        {
            "id": "agent_rocketride_1",
            "provider": "agent_rocketride",
            "name": "RocketRide Wave",
            "config": {
                "instructions": [
                    "You are a personal assistant with long-term, shared memory via the xtrace tools.",
                    "",
                    "At the start of each turn, call xtrace.recall with a query describing what you need to know about the user. Use the returned context to ground your answer.",
                    "After answering, call xtrace.remember with the relevant turns so you (or other agents sharing this memory) can use them later.",
                    "",
                    "For backend tasks (schema, auth, data queries, functions), use butterbase tools. Call butterbase.butterbase_docs with topic \"overview\" first to learn the platform.",
                    "",
                    "Use your internal memory only for short-term working notes within this run.",
                    "",
                    "Format your answer as:",
                    "  1. Direct answer to the question",
                    "  2. Key findings (bulleted)",
                    "  3. Any caveats or missing information",
                    "Keep answers under 400 words unless the user asks for detail."
                ],
                "max_waves": 15,
                "parameters": {}
            },
            "ui": {
                "position": {
                    "x": 240,
                    "y": 210
                },
                "nodeType": "default",
                "formDataValid": true
            },
            "input": [
                {
                    "lane": "questions",
                    "from": "chat_1"
                }
            ]
        },
